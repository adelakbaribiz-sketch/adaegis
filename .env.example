# AdAegis — environment variables
#
# STATUS: the current demo build reads none of these. The app runs entirely
# on mock data from src/lib/mock-data.ts with no server-side calls. This file
# documents the variables a real backend integration (see docs/ROADMAP.md)
# would need, so the shape is decided before that work starts.

# --- Google Ads API (not yet integrated) ---
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# --- Auth (not yet integrated — current demo uses a hardcoded client-side check) ---
NEXTAUTH_URL=
NEXTAUTH_SECRET=

# --- Database (not yet integrated) ---
DATABASE_URL=

# --- Third-party competitor intelligence (not yet integrated) ---
SEMRUSH_API_KEY=
SPYFU_API_KEY=

# --- Billing (not yet integrated) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Alerting (not yet integrated) ---
SLACK_WEBHOOK_URL=
